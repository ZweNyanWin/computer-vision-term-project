__pycache__/
*.pyc
.DS_Store

# Reference textbook kept locally for lookups. Large, and not ours to publish.
*.pdf

# Generated locally by the progress demo or the real reconstruction.
data/**
model3d/*
outputs/*

# Meshes the evaluation reconstructs on the way to a score: ~100 MB, and fully
# regenerable from the photographs. The CSVs beside them are the actual result
# and stay tracked, because the paper cites them.
output/**/meshes/

!data/.gitkeep
!model3d/.gitkeep
!outputs/.gitkeep

# Meshes cached while building figures; regenerable.
output/figures_cache/

# Photogrammetry: staged copies of photographs, the 32 MB usdz and the compiled
# tool. All regenerable -- the ring takes 60 s to reconstruct.
recon/input_*/
recon/*.usdz
recon/photogrammetry
recon/input_combined/
